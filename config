# 동양 관상·한지 컨셉 테마. 사용자가 설정에서 라이트/다크를 바꿔도 각각 맞는 색을 쓴다.

[browser]
gatherUsageStats = false

[server]
# 업로드 상한(MB). 앱은 10MB 초과 시 안내하고, 이보다 큰 파일은 메모리에 올리기 전에 Streamlit이 거부한다.
maxUploadSize = 15

[theme]
font = "sans-serif"
headingFont = "serif"
baseRadius = "0.75rem"
showSidebarBorder = true

[theme.light]
primaryColor = "#A8382B"              # 주홍 (한지 바탕 대비 약 5.6:1)
backgroundColor = "#F7F2E8"           # 한지 베이지
secondaryBackgroundColor = "#EDE4D3"
textColor = "#2B2724"                 # 먹색
borderColor = "#D9CDB8"

[theme.dark]
primaryColor = "#E07A5F"              # 어두운 바탕용 밝은 주홍
backgroundColor = "#1B1917"           # 먹 바탕
secondaryBackgroundColor = "#2A2622"
textColor = "#EFE8DC"
borderColor = "#3D3731"
